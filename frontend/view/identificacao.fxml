<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="18" styleClass="tela, card"
      xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.castore.controller.IdentificacaoController">
    <padding>
        <Insets top="50" right="50" bottom="50" left="50"/>
    </padding>

    <Label text="CA STORE" styleClass="titulo"/>
    <Label text="Sistema de Vendas — Centro Acadêmico" styleClass="subtitulo"/>

    <VBox spacing="8" styleClass="grupo-input">
        <Label text="Informe seu nome:" styleClass="rotulo"/>
        <TextField fx:id="campoNome" promptText="Digite seu nome aqui..."/>
    </VBox>

    <Label fx:id="labelErro" styleClass="erro" visible="false" managed="false"/>

    <Button text="Ver Cardápio" onAction="#iniciarPedido" styleClass="btn-primario"/>
</VBox>

