<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="16" styleClass="tela, card"
      xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.castore.controller.PagamentoController">
    <padding>
        <Insets top="30" right="30" bottom="30" left="30"/>
    </padding>

    <Label text="Pagamento" styleClass="titulo-secao"/>
    <Label fx:id="labelDataHora" styleClass="data-hora"/>

    <ScrollPane fitToWidth="true" styleClass="scroll-pagamento" VBox.vgrow="ALWAYS">
        <VBox fx:id="containerBlocos" spacing="16"/>
    </ScrollPane>

    <HBox alignment="CENTER_RIGHT" spacing="6" styleClass="total-geral">
        <Label text="Total Geral: R$"/>
        <Label fx:id="labelTotalGeral" styleClass="total-valor"/>
    </HBox>

    <HBox spacing="15" alignment="CENTER_RIGHT">
        <Button text="Alterar Itens" onAction="#voltar" styleClass="btn-secundario"/>
        <Button text="Confirmar e Finalizar" onAction="#finalizar" styleClass="btn-sucesso"/>
    </HBox>
</VBox>
